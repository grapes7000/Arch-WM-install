{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/arch-wm/widget-manifest.schema.json",
  "type": "object",
  "required": ["id", "name", "entry", "surfaces", "variants", "lockSafe", "services", "capabilities"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "entry": {"type": "string", "pattern": "^[^/]+\\.qml$"},
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["bar", "desktop", "lockscreen"]}
    },
    "variants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "lockSafe": {"type": "boolean"},
    "services": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "constraints": {"type": "object"}
  },
  "additionalProperties": true
}
