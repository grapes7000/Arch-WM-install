#!/usr/bin/env python3
"""Standalone CLI over the shared UI-style catalog in theme_runtime.

Kept for scripting/back-compat; the `theme` TUI's "Shell Style" screen uses
the same theme_runtime functions so the two can never drift apart.
"""
from __future__ import annotations

import sys
from pathlib import Path

# Resolve imports relative to this script's real location so this works both
# from a dev checkout (symlinked into ~/.local/bin) and once installed as a
# plain copy alongside theme_runtime.py.
sys.path.insert(0, str(Path(__file__).resolve().parent))

import theme_runtime


def usage() -> None:
    print("usage: ui-style [<name>|current|list|new <name> [--from <base>]]")


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args:
        print(theme_runtime.current_ui_style_name())
        return 0

    command = args[0]
    if command in {"-h", "--help", "help"}:
        usage()
        return 0
    if command in {"list", "--list"}:
        print("\n".join(theme_runtime.list_ui_styles()))
        return 0
    if command in {"current", "status"}:
        print(theme_runtime.current_ui_style_name())
        return 0
    if command == "new":
        if len(args) < 2:
            print("usage: ui-style new <name> [--from <base>]", file=sys.stderr)
            return 2
        name = args[1]
        base = "precision"
        if len(args) >= 4 and args[2] == "--from":
            base = args[3]
        try:
            payload = theme_runtime.load_ui_style(base)
        except theme_runtime.UiStyleError as error:
            print(f"ui-style: {error}", file=sys.stderr)
            return 1
        payload["description"] = f"Custom style based on {base}"
        path = theme_runtime.save_ui_style(name, payload)
        print(path)
        return 0
    if len(args) != 1:
        usage()
        return 2

    try:
        theme_runtime.apply_ui_style(command)
        print(f"UI style: {command}")
        return 0
    except theme_runtime.UiStyleError as error:
        print(f"ui-style: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
