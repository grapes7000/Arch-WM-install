#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import shutil
import sys
import tempfile
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
GENERATED = CONFIG / "theme-engine" / "generated"
DESTINATION = GENERATED / "ui-style.json"
SOURCE_DIR = Path(__file__).resolve().parent.parent / "ui-styles"


class StyleError(RuntimeError):
    pass


def profiles() -> list[str]:
    return sorted(path.stem for path in SOURCE_DIR.glob("*.json") if not path.stem.startswith("_"))


def load(name: str) -> dict:
    path = SOURCE_DIR / f"{name}.json"
    if not path.is_file():
        raise StyleError(f"unknown UI style: {name}")
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise StyleError(f"invalid profile {path}: {error}") from error
    if payload.get("schema_version") != 1:
        raise StyleError(f"unsupported schema in {path}")
    if not isinstance(payload.get("metrics"), dict) or not isinstance(payload.get("patterns"), dict):
        raise StyleError(f"profile {name} requires metrics and patterns")
    return payload


def atomic_copy(source: Path, destination: Path) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{destination.name}.", dir=destination.parent)
    os.close(fd)
    try:
        shutil.copyfile(source, temporary)
        os.chmod(temporary, 0o644)
        os.replace(temporary, destination)
    except Exception:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def current() -> str:
    try:
        payload = json.loads(DESTINATION.read_text(encoding="utf-8"))
        return str(payload.get("name") or "unknown")
    except (OSError, json.JSONDecodeError):
        return "precision (fallback)"


def usage() -> None:
    print("usage: ui-style [precision|legacy|win95|current|list]")


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args:
        print(current())
        return 0

    command = args[0]
    if command in {"-h", "--help", "help"}:
        usage()
        return 0
    if command in {"list", "--list"}:
        print("\n".join(profiles()))
        return 0
    if command in {"current", "status"}:
        print(current())
        return 0
    if len(args) != 1:
        usage()
        return 2

    try:
        load(command)
        source = SOURCE_DIR / f"{command}.json"
        atomic_copy(source, DESTINATION)
        print(f"UI style: {command}")
        return 0
    except StyleError as error:
        print(f"ui-style: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
