#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

from theme_apps import apply_detected, detect

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
THEME_JSON = CONFIG / "theme-engine/generated/theme.json"


def load_active_theme():
    if not THEME_JSON.is_file():
        raise RuntimeError(f"active theme contract not found: {THEME_JSON}")
    try:
        data = json.loads(THEME_JSON.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"cannot read active theme contract: {error}") from error
    if not isinstance(data, dict) or not isinstance(data.get("roles"), dict):
        raise RuntimeError("active theme contract is invalid")
    return data


def show_detected() -> int:
    found = detect()
    any_found = False
    for app, paths in found.items():
        if not paths:
            print(f"- {app}: not detected")
            continue
        any_found = True
        print(f"✓ {app}: {len(paths)} detected")
        for path in paths:
            print(f"    {path}")
    return 0 if any_found else 1


def apply() -> int:
    theme = load_active_theme()
    messages = apply_detected(theme)
    if not messages:
        print("No supported app profiles/vaults detected yet.")
        return 0
    for message in messages:
        print("✓ " + message)
    return 0


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "apply"
    try:
        if command in {"detect", "status"}:
            return show_detected()
        if command == "apply":
            return apply()
        if command in {"-h", "--help", "help"}:
            print("Usage: theme-apps [detect|status|apply]")
            return 0
        print(f"theme-apps: unknown command: {command}", file=sys.stderr)
        return 2
    except RuntimeError as error:
        print(f"theme-apps: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
