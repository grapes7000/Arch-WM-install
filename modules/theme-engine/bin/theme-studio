#!/usr/bin/env python3
"""Installed `theme` command: Theme Studio UI plus backward-compatible CLI."""
from __future__ import annotations

import colorsys
import json
import os
from pathlib import Path
import subprocess
import sys

import theme_runtime
from theme_schema import contrast_ratio, resolve_roles, validation_summary, validate_theme


def usage() -> str:
    return """theme — desktop theme studio

Interactive:
  theme                     Open Theme Studio
  theme studio              Open Theme Studio
  theme edit [name]         Open a theme in Theme Studio

Compatible commands:
  theme <name>              Apply a theme and Studio component overrides
  theme --list              List themes
  theme shape ...           Existing shape commands
  theme texture ...         Existing texture commands
  theme anim ...            Existing animation commands
  theme homepage ...        Existing homepage commands
  theme font ...            Existing font commands

Studio utilities:
  theme validate [name]     Validate a theme
  theme recover             Open Theme Studio recovery flow
  theme legacy ...          Run the previous command directly
"""


def run_legacy(args: list[str]) -> int:
    command = theme_runtime.legacy_command()
    if not command:
        print("theme: legacy generator was not found. Re-run the themes installer.", file=sys.stderr)
        return 127
    return subprocess.call(command + args)


def launch(name: str | None = None) -> int:
    if name:
        os.environ["THEME_STUDIO_THEME"] = name
    try:
        from theme_tui import launch as launch_tui
        launch_tui()
        return 0
    except KeyboardInterrupt:
        return 130
    except Exception as exc:
        print(f"theme: Theme Studio could not start: {exc}", file=sys.stderr)
        print("Falling back to the classic picker.", file=sys.stderr)
        return run_legacy([])


def _saturation(value: str) -> float:
    value = value.lstrip("#")
    red, green, blue = (int(value[index:index + 2], 16) / 255.0 for index in (0, 2, 4))
    return colorsys.rgb_to_hsv(red, green, blue)[1]


def palette_quality_issues(theme: dict) -> list[dict[str, str]]:
    """Advisory design checks for themes that tend to look flat or washed out."""
    roles = resolve_roles(theme.get("roles", {}))
    style = theme.get("style", {})
    issues: list[dict[str, str]] = []

    try:
        bg = roles["bg"]
        surface = roles.get("surface_1", roles.get("bg_alt", bg))
        border = roles.get("border_subtle", roles.get("border_normal", surface))
        accent = roles["accent"]
        accent2 = roles.get("accent2", accent)

        if contrast_ratio(bg, surface) < 1.08:
            issues.append({
                "level": "warning",
                "path": "roles.surface_1",
                "message": "Raised surfaces are almost the same luminance as the background; cards may look flat.",
            })
        if contrast_ratio(surface, border) < 1.10:
            issues.append({
                "level": "warning",
                "path": "roles.border_subtle",
                "message": "The subtle border barely separates from the surface; edges may disappear.",
            })
        if max(_saturation(accent), _saturation(accent2)) < 0.42:
            issues.append({
                "level": "warning",
                "path": "roles.accent",
                "message": "Both accent colors are low-saturation; the palette may look washed out.",
            })
    except (KeyError, TypeError, ValueError):
        pass

    surface_opacity = float(style.get("surface_opacity", 0.96) or 0.96)
    if surface_opacity < 0.82:
        issues.append({
            "level": "warning",
            "path": "style.surface_opacity",
            "message": "Very low panel opacity can mix surfaces into a gray, washed-out look.",
        })

    bar_height = int(style.get("bar_height", 48) or 48)
    bar_padding = int(style.get("bar_padding", 8) or 0)
    if bar_padding * 2 > max(0, bar_height - 16):
        issues.append({
            "level": "warning",
            "path": "style.bar_padding",
            "message": "Bar padding leaves less than 16px for content; Quickshell will clamp it safely.",
        })
    return issues


def validate(name: str | None) -> int:
    target = name or theme_runtime.active_theme()
    if not target:
        print("theme validate: no active theme", file=sys.stderr)
        return 2
    try:
        theme = theme_runtime.load_theme(target)
    except Exception as exc:
        print(f"theme validate: {exc}", file=sys.stderr)
        return 2
    issues = validate_theme(theme)
    issues.extend(palette_quality_issues(theme))
    errors, warnings = validation_summary(issues)
    print(f"{target}: {errors} error(s), {warnings} suggestion(s)")
    for issue in issues:
        icon = "✗" if issue["level"] == "error" else "!"
        print(f"{icon} {issue['path']}: {issue['message']}")
    return 1 if errors else 0


def main() -> int:
    args = sys.argv[1:]
    if not args:
        return launch()
    if args[0] in ("-h", "--help", "help"):
        print(usage())
        return 0
    if args[0] in ("studio", "recover"):
        return launch()
    if args[0] == "edit":
        return launch(args[1] if len(args) > 1 else theme_runtime.active_theme())
    if args[0] == "validate":
        return validate(args[1] if len(args) > 1 else None)
    if args[0] == "legacy":
        return run_legacy(args[1:])

    # Commands that are not theme names retain the existing CLI exactly.
    passthrough = {"shape", "texture", "anim", "effects", "homepage", "font", "starship", "install", "new", "menu", "picker", "wallpaper", "wallgen", "targets", "current", "status", "-l", "--list", "--validate", "validate"}
    if args[0] in passthrough or args[0].startswith("-"):
        code = run_legacy(args)
        if code == 0 and args[0] in {"shape", "texture", "anim", "effects", "homepage", "font", "starship"}:
            current = theme_runtime.active_theme()
            if current:
                try:
                    theme_runtime.apply_studio_overrides(current)
                except Exception as exc:
                    print(f"theme: Studio override warning: {exc}", file=sys.stderr)
        return code

    # Applying a named theme runs the stable generator first, then layers the
    # new component model on top so old themes and new Studio themes both work.
    try:
        result = theme_runtime.apply_theme(args[0])
    except Exception as exc:
        print(f"theme: {exc}", file=sys.stderr)
        return 1
    if result.get("legacy_message"):
        print(result["legacy_message"])
    print(f"Theme Studio overrides applied: {args[0]}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
