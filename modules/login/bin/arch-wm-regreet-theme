#!/usr/bin/env python3
"""Publish the active Arch-WM theme for the pre-login ReGreet account."""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import struct
import tempfile
import time
import zlib

HOME = Path.home()
CFG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache"))
CONTRACT = CFG / "theme-engine/generated/theme.json"
OUTPUT = Path(os.environ.get("ARCH_WM_GREETD_ASSET_DIR", "/var/lib/arch-wm-greeter"))


def atomic_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o640)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def color(roles: dict[str, str], key: str, fallback: str) -> str:
    value = str(roles.get(key, fallback))
    return value if len(value) == 7 and value.startswith("#") else fallback


def render(contract: dict) -> str:
    roles = contract.get("roles", {})
    style = contract.get("style", {})
    radius = max(0, min(40, int(style.get("corner_radius", 8))))
    border = max(0, min(6, int(style.get("border_width", 1))))
    bg = color(roles, "bg", "#111318")
    surface = color(roles, "surface_0", color(roles, "bg_alt", "#1b1f27"))
    text = color(roles, "text", "#f2f4f8")
    dim = color(roles, "text_dim", "#a8afbd")
    accent = color(roles, "accent", "#7aa2f7")
    urgent = color(roles, "urgent", "#f7768e")
    selected = color(roles, "selection_bg", accent)
    on_accent = color(roles, "on_accent", bg)
    return f'''/* Generated by arch-wm-regreet-theme. */
window {{ background: {bg}; color: {text}; }}
box {{ color: {text}; }}
frame, .card {{
  background: alpha({surface}, 0.96);
  border: {border}px solid alpha({accent}, 0.72);
  border-radius: {radius}px;
}}
entry, button, combobox {{
  background: alpha({surface}, 0.98);
  color: {text};
  border: {border}px solid alpha({dim}, 0.55);
  border-radius: {radius}px;
  padding: 10px 14px;
}}
entry:focus, button:focus, combobox:focus {{ border-color: {accent}; }}
button:hover {{ background: alpha({selected}, 0.72); }}
button.suggested-action {{ background: {accent}; color: {on_accent}; }}
button.destructive-action, .error {{ color: {urgent}; }}
label {{ color: {text}; }}
label.dim-label {{ color: {dim}; }}
selection {{ background: {selected}; color: {text}; }}
'''


def wallpaper(contract: dict) -> Path | None:
    name = str(contract.get("name", ""))
    for candidate in (
        CACHE / "theme-engine/wallpapers/current.png",
        CFG / f"hypr/wallpapers/{name}.png",
        CFG / "quickshell/homepage-images/theme-wallpaper.png",
    ):
        if candidate.is_file():
            return candidate.resolve()
    return None


def fallback_png(path: Path, background: str) -> None:
    """Write a valid one-pixel PNG so ReGreet always has a background."""
    value = background.lstrip("#")
    rgb = bytes(int(value[index:index + 2], 16) for index in (0, 2, 4))
    def chunk(kind: bytes, data: bytes) -> bytes:
        payload = kind + data
        return struct.pack(">I", len(data)) + payload + struct.pack(">I", zlib.crc32(payload))
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(b"\x00" + rgb))
    png += chunk(b"IEND", b"")
    temporary = path.with_name(f".{path.name}.{os.getpid()}")
    temporary.write_bytes(png)
    os.chmod(temporary, 0o640)
    os.replace(temporary, path)


def publish() -> None:
    contract = json.loads(CONTRACT.read_text(encoding="utf-8"))
    OUTPUT.mkdir(parents=True, exist_ok=True)
    atomic_text(OUTPUT / "regreet.css", render(contract))
    source = wallpaper(contract)
    if source:
        temporary = OUTPUT / f".background.{os.getpid()}.png"
        shutil.copyfile(source, temporary)
        os.chmod(temporary, 0o640)
        os.replace(temporary, OUTPUT / "background.png")
    else:
        fallback_png(OUTPUT / "background.png", color(contract.get("roles", {}), "bg", "#111318"))


def watch() -> None:
    previous = None
    while True:
        try:
            stamp = CONTRACT.stat().st_mtime_ns
            if stamp != previous:
                publish()
                previous = stamp
        except (OSError, ValueError, json.JSONDecodeError) as error:
            print(f"arch-wm-regreet-theme: {error}", flush=True)
        time.sleep(1)


def main() -> int:
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--once", action="store_true")
    mode.add_argument("--watch", action="store_true")
    args = parser.parse_args()
    if args.watch:
        watch()
    else:
        publish()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
