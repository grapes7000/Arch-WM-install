{
  "schema_version": 1,
  "widgets": [
    {
      "id": "workspaces",
      "name": "Workspaces",
      "entry": "Widget.qml",
      "surfaces": ["bar", "desktop"],
      "variants": ["compact", "standard"],
      "lockSafe": false,
      "services": ["hyprland"],
      "capabilities": ["workspace.switch"]
    },
    {
      "id": "active-window",
      "name": "Active Window",
      "entry": "Widget.qml",
      "surfaces": ["bar", "desktop"],
      "variants": ["compact", "standard"],
      "lockSafe": false,
      "services": ["active-window"],
      "capabilities": []
    },
    {
      "id": "clock",
      "name": "Clock",
      "entry": "Widget.qml",
      "surfaces": ["bar", "desktop", "lockscreen"],
      "variants": ["compact", "standard", "expanded"],
      "lockSafe": true,
      "services": ["time"],
      "capabilities": []
    },
    {
      "id": "system-stats",
      "name": "System Stats",
      "entry": "Widget.qml",
      "surfaces": ["bar", "desktop"],
      "variants": ["compact", "standard", "expanded"],
      "lockSafe": false,
      "services": ["system-stats"],
      "capabilities": ["drawer.open"],
      "panel": true
    },
    {
      "id": "battery",
      "name": "Battery",
      "entry": "Widget.qml",
      "surfaces": ["bar", "desktop", "lockscreen"],
      "variants": ["compact", "standard"],
      "lockSafe": true,
      "services": ["power"],
      "capabilities": []
    },
    {
      "id": "media",
      "name": "Media",
      "entry": "Widget.qml",
      "surfaces": ["bar", "desktop", "lockscreen"],
      "variants": ["compact", "standard"],
      "lockSafe": true,
      "services": ["mpris"],
      "capabilities": ["media.control", "drawer.open"],
      "panel": true
    },
    {
      "id": "volume",
      "name": "Volume",
      "entry": "Widget.qml",
      "surfaces": ["bar", "desktop"],
      "variants": ["compact", "standard"],
      "lockSafe": false,
      "services": ["audio"],
      "capabilities": ["audio.control"]
    },
    {
      "id": "network",
      "name": "Network",
      "entry": "Widget.qml",
      "surfaces": ["bar", "desktop", "lockscreen"],
      "variants": ["compact", "standard"],
      "lockSafe": true,
      "services": ["network"],
      "capabilities": ["drawer.open"],
      "panel": true
    },
    {
      "id": "notifications",
      "name": "Notifications",
      "entry": "Widget.qml",
      "surfaces": ["bar", "desktop"],
      "variants": ["compact", "standard"],
      "lockSafe": false,
      "services": ["notifications"],
      "capabilities": ["notification.dismiss"]
    },
    {
      "id": "session",
      "name": "Session",
      "entry": "Widget.qml",
      "surfaces": ["bar"],
      "variants": ["compact", "standard"],
      "lockSafe": false,
      "services": ["session"],
      "capabilities": ["session.lock"]
    },
    {
      "id": "weather",
      "name": "Weather",
      "entry": "Widget.qml",
      "surfaces": ["bar", "desktop", "lockscreen"],
      "variants": ["compact", "standard"],
      "lockSafe": true,
      "services": ["weather"],
      "capabilities": ["drawer.open"],
      "panel": true
    }
  ]
}
