{
  "$schema": "../../../schemas/widget-manifest.schema.json",
  "id": "session",
  "name": "Session",
  "entry": "Widget.qml",
  "surfaces": ["bar"],
  "variants": ["compact", "standard"],
  "lockSafe": false,
  "services": ["session"],
  "capabilities": ["session.lock"],
