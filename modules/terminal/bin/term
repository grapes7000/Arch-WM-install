#!/usr/bin/env bash
set -Eeuo pipefail

choose() {
  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "$@" | fzf --prompt='terminal › ' --height=45% --border=rounded
  else
    printf '%s\n' "$@"
    read -rp 'Choose an action: ' reply
    printf '%s\n' "$reply"
  fi
}

action="${1:-}"
if [[ -z "$action" ]]; then
  action="$(choose history files git monitor theme system doctor shortcuts)"
fi

case "$action" in
  history) exec atuin search -i ;;
  files) exec yazi "${2:-.}" ;;
  git)
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
      echo 'Not inside a Git repository.' >&2
      exit 1
    }
    exec lazygit
    ;;
  monitor) exec btm ;;
  theme)
    selected="$(theme --list | fzf --prompt='theme › ' --height=45% --border=rounded)"
    [[ -n "$selected" ]] && exec theme "$selected"
    ;;
  system) exec fastfetch ;;
  doctor)
    root="${ARCH_WM_REPO:-$HOME/Projects/Arch-WM-install}"
    if [[ -f "$root/install.sh" ]]; then
      exec python -m installer doctor
    fi
    echo 'Set ARCH_WM_REPO to the Arch-WM-install checkout to run doctor.' >&2
    exit 1
    ;;
  shortcuts)
    cat <<'EOF'
Ctrl-R           Atuin history search
Ctrl-T           FZF file search
Alt-C            FZF directory search
Ctrl-Shift-H     Kitty scrollback
Ctrl-Shift-F     Search Kitty scrollback
Ctrl-Shift-P     Open a detected filesystem path
Ctrl-Shift-O     Open a detected hyperlink
term             Terminal command palette
EOF
    ;;
  *)
    echo "Unknown terminal action: $action" >&2
    exit 2
    ;;
esac
